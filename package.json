{
  "name": "tg-chat-mock-renderer",
  "version": "1.10.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/web/server.js",
    "dev": "node --watch --watch-path=src --watch-path=templates --watch-path=public src/web/server.js",
    "bot": "node src/index.js",
    "render": "node src/cli-render.js",
    "render:random": "node src/cli-render.js random",
    "test:golden": "node scripts/golden-render.mjs",
    "test:golden:update": "node scripts/golden-render.mjs --update",
    "wallpaper:from-screenshot": "node scripts/extract-wallpaper-from-ui-screenshot.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "playwright": "1.59.1",
    "sharp": "^0.34.5",
    "telegraf": "^4.16.3"
  }
}
