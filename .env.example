# Порт веб-интерфейса
PORT=3000

# Явно выключить вход, если в системе остался старый AUTH_ENABLED:
# AUTH_ENABLED=0

# Откуда брать картинки для аватаров (по умолчанию — корень проекта)
# AVATAR_IMAGE_ROOT=

# Чёткость захвата в Chromium (deviceScaleFactor); на части ОС не влияет на размер файла —
# итоговая ширина PNG всё равно приводится к эталону через Sharp (см. ниже).
# По умолчанию — расчётный DPR под эталон дисплея; переопределение:
# RENDER_DPR=4

# Нормализация ширины PNG к эталону: iOS — (RENDER_IOS_PPI / 25.4) * RENDER_IOS_WIDTH_MM,
# по умолчанию 460 ppi × 71.5 мм ≈ 1295 px; Android — Xiaomi 15 Ultra 3200 px (высота — по контенту).
# Переопределить плотность iOS: RENDER_IOS_PPI=500  или ширину в мм: RENDER_IOS_WIDTH_MM=72
# Отключить (сырой скрин как выдал браузер): RENDER_ETALON=0
#
# iOS — сверхдискретизация захвата (множитель к DPR), затем даунскейл к эталону → более резкий текст.
# По умолчанию 1.4; выключить: RENDER_IOS_SUPER_SAMPLE=0  или свой множитель 1.5 и т.д.

# --- Опционально: вход через Telegram (когда доработаете проект) ---
# AUTH_ENABLED=1
# BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# ALLOWED_TELEGRAM_IDS=
# SESSION_SECRET=
# TRUST_SECURE_COOKIES=1
