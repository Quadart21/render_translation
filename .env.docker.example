# --- Docker / production (screen.norenvpn.com) ---
# Скопируйте в .env на сервере: cp .env.docker.example .env

PORT=3000
NODE_ENV=production

# Обязательно для HTTPS за nginx
TRUST_SECURE_COOKIES=1

# Авторизация панели
AUTH_ENABLED=1
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_BOT_USERNAME=REPLACE_WITH_BOT_USERNAME
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Email для Let's Encrypt (используется docker/scripts/init-ssl.sh)
LETSENCRYPT_EMAIL=admin@norenvpn.com

# Домен (по умолчанию в nginx уже screen.norenvpn.com)
DOMAIN=screen.norenvpn.com

# Опционально: стартовые Telegram ID через env (иначе первый вход = админ)
# ALLOWED_TELEGRAM_IDS=

# Пути внутри контейнера (не менять без правки docker-compose.yml)
AUTH_ACCESS_FILE=/app/data/telegram-access.json
AVATAR_IMAGE_ROOT=/app/avatar
